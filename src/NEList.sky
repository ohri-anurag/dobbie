module NEList exposing (..)

type NEList a
    = NEList a (List a)


fromList : List a -> Maybe (NEList a)
fromList xs =
    case xs of

        x :: rest ->
            Just (NEList x rest)

        _ ->
            Nothing


map : (a -> b) -> NEList a -> NEList b
map f (NEList x xs) =
    NEList (f x) (List.map f xs)


head : NEList a -> a
head (NEList x _) =
    x
