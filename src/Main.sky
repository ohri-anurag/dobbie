module Main exposing (main)

import ListZipper as LZ
import List.Extended as List
import NEList as NEList
import Sky.Core.Error exposing (Error)
import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task exposing (Task)
import Std.Ui.Border as Border
import Std.App as App
import Std.Cmd as Cmd
import Std.Db as Db
import Std.Sub as Sub
import Std.Tui as Tui
import Std.Ui as Ui exposing (Element)
import Std.Ui.Font as Font

type alias KeyEvent =
    { kind : String
    , value : String
    }

type Msg
    = Schemas (NEList String)
    | NoSchemas
    | Tables (NEList String)
    | NoTables String
    | Rows (NEList (List String))
    | NoRows Table
    | KeyPress KeyEvent
    | CriticalError String


connectionStr =
    "postgres://anuragohri92@localhost:5432/northwind"

type Selector
    = SelectSchema (NEList String) (ListZipper String)
    | SelectTable String (NEList String) (ListZipper String)

type alias Table =
    { name : String
    , schema : String
    }

type Mode
    = FetchingSchemas
    | NoSchemasMode
    | FetchingTables String
    | NoTablesMode String
    | FetchingRows Table
    | NoRowsMode Table
    | RowsMode (NEList (List String))
    | Select Selector

type alias Model =
    { count : Int
    , conn : Db.Db
    , mode : Mode
    }


init : Db -> ( Model, Cmd Msg )
init db =
    let
        handler result =
            case result of

                Err err ->
                    Error.toString err
                        |> String.append
                               "Could not fetch schemas from the DB server: "
                        |> CriticalError

                Ok schemas ->
                    case NEList.fromList (List.concatMap Dict.values schemas) of

                        Nothing ->
                            NoSchemas

                        Just neSchemas ->
                            Schemas neSchemas
    in
        ( { count = 0, conn = db, mode = FetchingSchemas }
        , Cmd.perform
              (Db.query
                  db
                  "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT LIKE 'pg_%' AND schema_name <> 'information_schema';"
                  [])
              handler
        )


update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        NoSchemas ->
            ( { model | mode = NoSchemasMode }, Cmd.none )

        Schemas schemas ->
            ( { model
                  | mode =
                      case model.mode of

                          FetchingSchemas ->
                              Select
                                  (LZ.fromList schemas |> SelectSchema schemas)

                          _ ->
                              model.mode
              }
            , Cmd.none
            )

        NoTables schema ->
            ( { model | mode = NoTablesMode schema }, Cmd.none )

        Tables tables ->
            ( { model
                  | mode =
                      case model.mode of

                          FetchingTables schema ->
                              Select
                                  (LZ.fromList tables
                                      |> SelectTable schema tables)

                          _ ->
                              model.mode
              }
            , Cmd.none
            )

        NoRows table ->
            ( { model | mode = NoRowsMode table }, Cmd.none )

        Rows rows ->
            ( { model | mode = RowsMode rows }, Cmd.none )

        CriticalError err ->
            ( model, Cmd.none )

        KeyPress key ->
            case ( key.kind, key.value ) of

                ( "up", _ ) ->
                    case model.mode of

                        Select selector ->
                            ( case selector of

                                  SelectSchema list lz ->
                                      { model
                                          | mode =
                                              Select <| SelectSchema list
                                                  <| LZ.backward lz
                                      }

                                  SelectTable schema list lz ->
                                      { model
                                          | mode =
                                              Select <| SelectTable schema list
                                                  <| LZ.backward lz
                                      }
                            , Cmd.none
                            )

                        _ ->
                            ( model, Cmd.none )

                ( "down", _ ) ->
                    case model.mode of

                        Select selector ->
                            ( case selector of

                                  SelectSchema list lz ->
                                      { model
                                          | mode =
                                              Select <| SelectSchema list
                                                  <| LZ.forward lz
                                      }

                                  SelectTable schema list lz ->
                                      { model
                                          | mode =
                                              Select <| SelectTable schema list
                                                  <| LZ.forward lz
                                      }
                            , Cmd.none
                            )

                        _ ->
                            ( model, Cmd.none )

                ( "enter", _ ) ->
                    case model.mode of

                        Select selector ->
                            case selector of

                                SelectSchema list lz ->
                                    let
                                        selected = lz.current
                                        handler result =
                                            case result of

                                                Err err ->
                                                    Error.toString err
                                                        |> String.append
                                                               "Could not fetch tables from the DB server: "
                                                        |> CriticalError

                                                Ok tables ->
                                                    case NEList.fromList
                                                             (List.concatMap
                                                                 Dict.values
                                                                 tables) of

                                                        Nothing ->
                                                            NoTables selected

                                                        Just neTables ->
                                                            Tables neTables
                                    in
                                        ( { model
                                              | mode = FetchingTables selected
                                          }
                                        , Cmd.perform
                                              (Db.query
                                                  model.conn
                                                  (String.concat
                                                      [ "SELECT table_name FROM information_schema.tables WHERE table_schema = '"
                                                      , selected
                                                      , "' "
                                                      , "order by table_name"
                                                      ])
                                                  [])
                                              handler
                                        )

                                SelectTable schema list lz ->
                                    let
                                        selected = lz.current
                                        handler result =
                                            case result of

                                                Err err ->
                                                    Error.toString err
                                                        |> String.append
                                                               "Could not fetch rows for table: "
                                                        |> CriticalError

                                                Ok rows ->
                                                    case NEList.fromList
                                                             (List.map
                                                                 Dict.values
                                                                 rows) of

                                                        Nothing ->
                                                            NoRows
                                                                { name =
                                                                    selected
                                                                , schema =
                                                                    schema
                                                                }

                                                        Just neRows ->
                                                            Rows neRows
                                    in
                                        ( { model
                                              | mode = FetchingTables selected
                                          }
                                        , Cmd.perform
                                              (Db.query
                                                  model.conn
                                                  (String.concat
                                                      [ "SELECT * FROM "
                                                      , schema
                                                      , "."
                                                      , selected
                                                      , " limit 10 "
                                                      ])
                                                  [])
                                              handler
                                        )

                        _ ->
                            ( model, Cmd.none )

                ( "char", "s" ) ->
                    ( { model | mode = FetchingSchemas }, Cmd.none )

                _ ->
                    ( model, Cmd.none )


view : Model -> String
view model =
    case model.mode of

        FetchingSchemas ->
            "Fetching schemas"

        NoSchemasMode ->
            "There are no schemas"

        FetchingTables schema ->
            String.append "Fetching tables for schema: " schema

        NoTablesMode schema ->
            String.append "There are no tables for schema: " schema

        NoRowsMode table ->
            String.concat
                [ "No rows found for ", table.schema, ".", table.name ]

        RowsMode (NEList x xs) ->
            x :: xs
                |> List.map
                       (\row -> List.intersperse " | " row |> String.concat)
                |> List.intersperse "\n"
                |> String.concat

        Select selector ->
            case selector of

                SelectSchema (NEList x xs) lz ->
                    let
                        schemaEls =
                            List.indexedMap
                                (\i e ->
                                    let
                                        begin =
                                            if i == lz.index then
                                                ">"

                                            else
                                                " "
                                    in
                                        String.append begin e)
                                (x :: xs)
                        search = "Search: "
                    in
                        search :: schemaEls |> List.intersperse "\n"
                            |> String.concat

                SelectTable schema (NEList x xs) lz ->
                    let
                        tableEls =
                            List.indexedMap
                                (\i e ->
                                    let
                                        begin =
                                            if i == lz.index then
                                                ">"

                                            else
                                                " "
                                    in
                                        String.append begin e)
                                (x :: xs)
                        search = "Search: "
                    in
                        search :: tableEls |> List.intersperse "\n"
                            |> String.concat

        FetchingRows table ->
            String.concat
                [ "Fetching rows for ", table.schema, ".", table.name ]


subscriptions : Model -> Sub Msg
subscriptions _ =
    Sub.none


appDef : Db -> AppConfig Model Msg
appDef conn =
    Tui.config
        { init = \() -> init conn
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> Tui.withOnKey KeyPress


main : Task Error ()
main =
    Db.open "postgres" connectionStr
        |> Task.andThen (\conn -> appDef conn |> Tui.program)
